rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules, then Publish.
// Everyone can read the portfolio; only the admin Google account can write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'samuelkevinlaluyan@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /{collection}/{docId} {
      allow read: if collection in ['content', 'projects', 'experience', 'skills'];
      allow write: if isAdmin();
    }
  }
}
